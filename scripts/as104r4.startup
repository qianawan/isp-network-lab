#!/bin/bash

ip link show dummy0 >/dev/null 2>&1 || ip link add dummy0 type dummy
ip link set dummy0 up

systemctl start rsyslog
systemctl start frr

# Wait until FRR configures the client-side address
for i in $(seq 1 30); do
    ip -4 addr show eth0 | grep -q "1.104.2.1" && break
    sleep 1
done

# Wait until the DHCP server is reachable
for i in $(seq 1 60); do
    ip route get 1.104.1.3 >/dev/null 2>&1 && break
    sleep 1
done

systemctl start isc-dhcp-relay
