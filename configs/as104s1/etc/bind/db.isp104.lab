$TTL 3600
@       IN      SOA     ns.isp104.lab. admin.isp104.lab. (
                        2026092001      ; serial
                        3600            ; refresh
                        1800            ; retry
                        604800          ; expire
                        86400 )         ; negative TTL

@       IN      NS      ns.isp104.lab.

; ================= server network 1.104.1.0/24 =================
ns              IN      A       1.104.1.2
s1              IN      A       1.104.1.2
dhcpd           IN      A       1.104.1.3
s2              IN      A       1.104.1.3
www             IN      A       1.104.1.4
s3              IN      A       1.104.1.4

; ========== client network 1.104.2.0/24 (assigned via DHCP) ==========
c1              IN      A       1.104.2.2
c2              IN      A       1.104.2.3

; ===================== router interfaces =====================
r1              IN      A       1.104.0.1
r1-eth0         IN      A       1.0.0.5
r1-eth1         IN      A       1.104.0.21
r1-eth2         IN      A       1.104.0.17
r1-eth3         IN      A       1.104.0.33

r2              IN      A       1.104.0.2
r2-eth0         IN      A       2.21.0.1
r2-eth1         IN      A       1.104.0.22
r2-eth2         IN      A       1.104.0.25

r3              IN      A       1.104.0.3
r3-eth0         IN      A       1.104.1.1
r3-eth1         IN      A       1.104.0.30
r3-eth2         IN      A       1.104.0.26
r3-eth3         IN      A       1.104.0.34

r4              IN      A       1.104.0.4
r4-eth0         IN      A       1.104.2.1
r4-eth1         IN      A       1.104.0.29
r4-eth2         IN      A       1.104.0.18
